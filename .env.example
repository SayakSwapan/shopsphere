# Copy this file to .env locally, then paste the same values into Vercel.
# NEVER commit your real .env — it is git-ignored.

# ===== Database (TiDB Cloud Serverless, MySQL-compatible) =====
# From TiDB Cloud "Connect" dialog. Example format:
DATABASE_URL="mysql://<user>:<password>@<host>:4000/<dbname>?sslaccept=strict"

# ===== Security =====
# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
AUTH_SECRET=

# ===== Site URL =====
# Your live URL, no trailing slash: https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL=

# ===== Cloudinary (product images) =====
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Razorpay (payments) =====
# Use Test Mode keys first: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ===== Email (Gmail via nodemailer) =====
# EMAIL_USER = your Gmail address. EMAIL_PASS = a Gmail "App Password" (needs 2-Step Verification on).
EMAIL_USER=
EMAIL_PASS=

# ===== Optional: Google Sign-In (skip if not used) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Optional: SMS via Twilio (skip if not used) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===== Optional: WhatsApp Business API (skip if not used) =====
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
