model TransactionCharge {
  id          String   @id @default(cuid())
  minAmount   Decimal  @db.Decimal(10,2)
  maxAmount   Decimal? @db.Decimal(10,2)
  feeType     String   @default("FLAT")       // FLAT | PERCENT | FLAT_PERCENT
  feeValue    Decimal  @db.Decimal(10,2)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  description String?  @db.Text

  // Enhanced fee options
  minFee       Decimal? @db.Decimal(10,2)     // minimum fee charged (for percentage)
  maxFee       Decimal? @db.Decimal(10,2)     // maximum fee cap (for percentage)
  gstOnFee     Boolean  @default(false)       // apply GST on the calculated fee
  effectiveDate DateTime?                      // rule becomes active from this date
  expiryDate   DateTime?                       // rule expires after this date
  priority     Int      @default(0)            // higher priority = evaluated first (override sortOrder)
  gateway      String?                         // restrict to specific gateway (null = all)
  paymentMethod String?                        // restrict to COD/RAZORPAY (null = all)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([priority])
  @@index([effectiveDate])
  @@index([expiryDate])
}

