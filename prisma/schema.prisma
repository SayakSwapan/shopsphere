  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Enhanced expense fields
  vendor        String?                         // supplier/vendor name
  invoiceNumber String?                         // invoice reference
  attachment    String?                         // file/image URL
  paymentMethod String?                         // cash/bank/UPI/card
  approvalStatus String  @default("APPROVED")   // PENDING | APPROVED | REJECTED
