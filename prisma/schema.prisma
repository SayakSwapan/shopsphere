generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model address {
  id           String   @id
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Address_userId_fkey")

  @@index([userId])
}

model cart {
  id        String     @id @default(cuid())
  userId    String?    @unique(map: "Cart_userId_key")
  createdAt DateTime   @default(now())
  updatedAt DateTime
  user      user?      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Cart_userId_fkey")
  cartitem  cartitem[]
}

model cartitem {
  id               String         @id @default(cuid())
  cartId           String
  productId        String
  productVariantId String?
  quantity         Int            @default(1)

  // Custom printing (name / number / design image) chosen at purchase time.
  customization    Json?

  createdAt        DateTime       @default(now())
  cart             cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, map: "CartItem_cartId_fkey")
  product          product        @relation(fields: [productId], references: [id], map: "CartItem_productId_fkey")
  productvariant   productvariant? @relation(fields: [productVariantId], references: [id], map: "CartItem_productVariantId_fkey")

  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
}

model category {
  id           String       @id
  name         String
  slug         String       @unique(map: "Category_slug_key")
  image        String?
  icon         String?
  itemCount    Int          @default(0)
  sortOrder    Int          @default(0)
  isActive     Boolean      @default(true)
  sizeCategory String @default("CLOTHING")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())
  product      product[]
  sportsCategoryItem SportsCategoryItem[]
}

model gender {
  id             String           @id
  name           String           @unique(map: "Gender_name_key")
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  productvariant productvariant[]
  size           size[]
}

model order {
  id               String       @id
  userId           String
  totalAmount      Decimal      @db.Decimal(10, 2)
  status           order_status @default(PENDING)
  createdAt        DateTime     @default(now())
  orderNumber      String       @unique(map: "Order_orderNumber_key")
  updatedAt        DateTime     @updatedAt

  inventoryUpdated Boolean      @default(false)

  addressLine1     String
  addressLine2     String?
  city             String
  country          String       @default("India")
  fullName         String
  phone            String
  pincode          String
  state            String

  user             user         @relation(fields: [userId], references: [id], map: "Order_userId_fkey")
  orderitem        orderitem[]

  // Notes an offline walk-in sale: an optional admin-typed contact/address.
  // `orderType` distinguishes online vs offline checkout streams (same order
  // + inventory system underneath). `createdById` tracks which admin raised
  // an offline order for audit purposes.
  orderType       OrderType   @default(ONLINE)
  createdById     String?
  isWalkIn        Boolean     @default(false)
  offlineEmail    String?
  offlineAddressLine1 String?
  offlineAddressLine2 String?
  offlineCity     String?
  offlineState    String?
  offlinePincode  String?

  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  paidAt DateTime?

  trackingUrl String?

  subtotal Decimal? @db.Decimal(10,2)
  gst      Decimal? @db.Decimal(10,2)
  shipping Decimal? @db.Decimal(10,2)
  discount Decimal? @default(0) @db.Decimal(10,2)

  couponId String?

  transactionFee Decimal? @default(0) @db.Decimal(10,2)

coupon Coupon? @relation(fields: [couponId], references: [id])

  couponUsage CouponUsage?

  return_request return_request[]
  replacement_request replacement_request[]
  refund refund[]
  callbackRequest callbackRequest[]
  paymentTransactions PaymentTransaction[]
  productQueries productQuery[]
  stockmovement stockmovement[]
  createdBy user? @relation("OrderCreatedBy", fields: [createdById], references: [id])

  @@index([userId])
  @@index([orderType])
}

model orderitem {
  id        String  @id
  orderId   String
  productId String
  quantity  Int
  price     Float
  total     Float

  // Snapshot of the ordered variant taken at checkout so packing details
  // stay accurate even after the product/variant is later edited or deleted.
  variantSku    String?
  variantSize   String?
  variantGender String?

  // Snapshot of the custom printing (name / number / design image) requested
  // by the customer at checkout. Immutable once the order is placed.
  customization Json?

  // Financial snapshots captured at order creation time.
  // These NEVER change regardless of future product price/cost edits,
  // ensuring historical COGS, profit, and margin reports remain accurate.
  sellingPriceSnapshot Decimal? @db.Decimal(10, 2)
  mrpSnapshot          Decimal? @db.Decimal(10, 2)
  costPriceSnapshot    Decimal? @db.Decimal(10, 2)
  gstSnapshot          Decimal? @db.Decimal(10, 2)
  discountSnapshot     Decimal? @db.Decimal(10, 2) @default(0)

  // Offline / POS sale snapshots (populated only for OFFLINE orders). These
  // preserve the exact financial picture at the moment of the sale so later
  // product price/cost edits never alter historical records.
  lastSellingPriceAtSale Decimal? @db.Decimal(10, 2)
  actualSellingPrice     Decimal? @db.Decimal(10, 2) // customer selling price (pre-GST)
  gstPercentageAtSale    Float?
  gstAmountAtSale        Decimal? @db.Decimal(10, 2)
  profitAmountAtSale     Decimal? @db.Decimal(10, 2)
  profitPercentAtSale    Decimal? @db.Decimal(10, 2)

  order     order   @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "OrderItem_orderId_fkey")
  product   product @relation(fields: [productId], references: [id], map: "OrderItem_productId_fkey")

  @@index([orderId])
  @@index([productId])
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  orderId           String
  gateway           String   @default("RAZORPAY")
  paymentMethod     String   @default("RAZORPAY")
  grossAmount       Decimal  @db.Decimal(10, 2)
  gatewayFee        Decimal? @db.Decimal(10, 2) @default(0)
  gatewayGST        Decimal? @db.Decimal(10, 2) @default(0)
  platformFee       Decimal? @db.Decimal(10, 2) @default(0)
  bankCharge        Decimal? @db.Decimal(10, 2) @default(0)
  netSettlement     Decimal? @db.Decimal(10, 2)
  settlementStatus  String   @default("PENDING")
  settlementDate    DateTime?
  paymentStatus     String   @default("PENDING")
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?
  webhookPayload    Json?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order order @relation(fields: [orderId], references: [id], map: "PaymentTransaction_orderId_fkey")

  @@index([orderId])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([settlementStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model product {
  id             String           @id
  name           String
  slug           String           @unique(map: "Product_slug_key")
  description    String           @db.Text
  sellingPrice Decimal @db.Decimal(10,2)
  costPrice Decimal @default(0) @db.Decimal(10,2) 

  // Minimum allowed offline (POS) selling price. Derived from costPrice, GST
  // and lastSellingProfitPercentage via the centralized pricing utility.
  // NULL until the admin configures offline pricing for the product.
  lastSellingProfitPercentage Decimal? @db.Decimal(5,2)
  lastSellingPrice           Decimal? @db.Decimal(10,2)

  discountType String @default("PERCENT") 
  discountValue Float @default(0) 
  salePrice Float @default(0) 
  offerStart DateTime?
  offerEnd DateTime?
  finalPrice Float @default(0)
  gstPercentage Float @default(0)
  weight Int @default(0) // grams
  stock          Int
  categoryId     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  isFeatured     Boolean          @default(false)
  status         Boolean          @default(true)
  lowStockAlert  Int              @default(5)
  isTrending     Boolean          @default(false)
  isReturnable   Boolean          @default(false)
  isReplaceable  Boolean          @default(false)
  returnDays     Int              @default(0)
  replaceDays    Int              @default(0)
  totalSold      Int              @default(0)
  totalViews     Int              @default(0)

  // Custom printing configuration set by the admin at product create/edit
  // time. When customPrintEnabled is on, customers can personalise the item
  // (name, number 000-999, or an uploaded design image) before adding to cart.
  customPrintEnabled Boolean @default(false)
  customPrintName    Boolean @default(false)
  customPrintNumber  Boolean @default(false)
  customPrintImage   Boolean @default(false)
  customPrintPrice Float @default(0) // extra charge per customised item, pre-GST

  // Pincodes where this product cannot be delivered. Empty = deliverable everywhere.
  restrictedPincodes String[] @default([])

  cartitem       cartitem[]
  orderitem      orderitem[]
  category       category         @relation(fields: [categoryId], references: [id], map: "Product_categoryId_fkey")
  productimage   productimage[]
  productvariant productvariant[]
  review         review[]
  stockmovement  stockmovement[]
  wishlistitem   wishlistitem[]
  coupon         Coupon[]
  callbackRequest callbackRequest[]
  metaTitle       String?   @db.VarChar(255)
metaDescription String?   @db.Text
metaKeywords    String?   @db.Text
  sizeChartId     String?
  sizeChart       sizechart? @relation(fields: [sizeChartId], references: [id])
  productQueries  productQuery[]
  printTypes      ProductPrintType[]
  sportsFeaturedProduct SportsFeaturedProduct[]
  @@index([categoryId])
}

/**
 * A print style a customer can pick when personalising an item (e.g.
 * "Normal Print", "Rubber Print", "Premium Print"). The print charge is
 * derived from pricePerLetter × letters typed plus an optional designFee
 * when the customer uploads a design image.
 */
model printtype {
  id             String   @id @default(cuid())
  name           String   @unique(map: "PrintType_name_key")
  description    String?
  pricePerLetter Decimal  @db.Decimal(10, 2)
  minLetters     Int      @default(0)
  maxLetters     Int      @default(20)
  designFee      Decimal  @db.Decimal(10, 2) @default(0)
  allowName      Boolean  @default(true)
  allowNumber    Boolean  @default(true)
  allowImage     Boolean  @default(true)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products ProductPrintType[]

  @@index([isActive], map: "PrintType_isActive_idx")
  @@index([sortOrder], map: "PrintType_sortOrder_idx")
}

/** Links a product to the print styles it offers for personalisation. */
model ProductPrintType {
  id          String    @id @default(cuid())
  productId   String
  printTypeId String
  createdAt   DateTime  @default(now())

  product   product   @relation(fields: [productId], references: [id], onDelete: Cascade, map: "ProductPrintType_productId_fkey")
  printType printtype @relation(fields: [printTypeId], references: [id], onDelete: Cascade, map: "ProductPrintType_printTypeId_fkey")

  @@unique([productId, printTypeId], map: "ProductPrintType_productId_printTypeId_key")
  @@index([printTypeId], map: "ProductPrintType_printTypeId_idx")
}

model ShippingRule {
   id                     String   @id @default(cuid())

  name                   String

  minWeight              Int
  maxWeight              Int

  shippingCharge         Decimal @db.Decimal(10,2)

  freeShippingEnabled    Boolean @default(true)

  freeShippingAmount     Decimal @db.Decimal(10,2)

  isActive               Boolean @default(true)

  priority               Int @default(1)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model StoreSetting {
  id String @id @default(cuid())

  freeShippingEnabled Boolean @default(false)

  freeShippingMinimum Decimal @default(1000) @db.Decimal(10,2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model pincode {
  id            String   @id @default(cuid())
  pincode       String   @unique
  isDeliverable Boolean  @default(true)
  estimatedDays Int      @default(3)
  allowCod      Boolean  @default(true)
  allowOnline   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model productimage {
  id        String   @id
  productId String
  url       String
  createdAt DateTime @default(now())
  product   product  @relation(fields: [productId], references: [id], map: "ProductImage_productId_fkey")

  @@index([productId])
}

model productvariant {
  id        String   @id
  productId String
  genderId  String
  sizeId    String
  stock     Int
  sku       String
  createdAt DateTime @default(now())
  updatedAt DateTime
  gender    gender   @relation(fields: [genderId], references: [id], map: "ProductVariant_genderId_fkey")
  product   product  @relation(fields: [productId], references: [id], map: "ProductVariant_productId_fkey")
  size      size     @relation(fields: [sizeId], references: [id], map: "ProductVariant_sizeId_fkey")
  cartitem  cartitem[]
  stockmovement stockmovement[]

  @@index([genderId])
  @@index([productId])
  @@index([sizeId])
}

model size {
  id             String           @id
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  genderId       String
  sizeCategory   String           @default("CLOTHING")
  sizeCode       String
  sizeName       String
  sizeUnit       String
  updatedAt      DateTime
  productvariant productvariant[]
  gender         gender           @relation(fields: [genderId], references: [id], map: "Size_genderId_fkey")

  @@index([genderId])
}

model stockmovement {
  id        String             @id
  productId String
  type      stockmovement_type
  quantity  Int
  note      String?
  createdAt DateTime           @default(now())
  product   product            @relation(fields: [productId], references: [id], onDelete: Cascade, map: "StockMovement_productId_fkey")

  // Optional contextual info for SALE / RESTOCK movements.
  variantId   String?
  variant     productvariant? @relation(fields: [variantId], references: [id], map: "StockMovement_variantId_fkey")
  orderId     String?
  order       order?         @relation(fields: [orderId], references: [id], map: "StockMovement_orderId_fkey")
  orderType   OrderType?
  referenceOrder String?
  // Stock levels before/after this movement (helps SALE history show 10 -> 8).
  beforeQuantity Int?
  afterQuantity  Int?

  @@index([productId])
  @@index([variantId])
  @@index([orderId])
  @@index([orderType])
  @@index([createdAt])
}

model wishlist {
  id           String         @id @default(cuid())
  userId       String?        @unique(map: "Wishlist_userId_key")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  user         user?          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Wishlist_userId_fkey")
  wishlistitem wishlistitem[]
}

model wishlistitem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  product    product  @relation(fields: [productId], references: [id], map: "WishlistItem_productId_fkey")
  wishlist   wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade, map: "WishlistItem_wishlistId_fkey")

  @@unique([wishlistId, productId], map: "WishlistItem_wishlistId_productId_key")
  @@index([productId])
}

model WishlistCouponLog {
  id         String   @id @default(cuid())
  couponId   String
  userId     String
  productId  String
  sentAt     DateTime @default(now())

  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId, productId])
  @@index([couponId])
  @@index([userId])
  @@index([productId])
}

model policy {
  id        String   @id
  title     String
  slug      String   @unique(map: "Policy_slug_key")
  type      String   @default("General")
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  rating      Int
  comment     String   @db.Text
  images      Json?
  verified    Boolean  @default(false)
  isBot       Boolean  @default(false)
  displayName String?  @db.VarChar(100)
  createdAt   DateTime @default(now())
  product     product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "Review_productId_fkey")
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Review_userId_fkey")

  @@index([productId])
  @@index([userId])
}
model account {
  id                String @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              user   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Account_userId_fkey")

  @@unique([provider, providerAccountId], map: "Account_provider_providerAccountId_key")
  @@index([userId])
}

model session {
  id           String   @id
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Session_userId_fkey")

  @@index([userId])
}

model user {
  id String @id @default(cuid())

  name String?
  email String @unique(map: "User_email_key")
  phone String?

  password String?

  role user_role @default(CUSTOMER)

  isVerified Boolean @default(false)
  isActive Boolean @default(true)

  // Lightweight walk-in customer created on-the-fly during an offline sale.
  // Such users carry an auto-generated placeholder email and no password.
  isWalkIn Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailOtp String?
  emailOtpExpiry DateTime?

  phoneOtp String?
  phoneOtpExpiry DateTime?

  phoneVerified Boolean @default(false)
  emailVerified Boolean @default(false)

  /*
  |--------------------------------------------------------------------------
  | Partner Approval
  |--------------------------------------------------------------------------
  */

  approvalStatus PartnerApprovalStatus @default(PROFILE_PENDING)

  isApproved Boolean @default(false)

  profileCompleted Boolean @default(false)

  /*
  |--------------------------------------------------------------------------
  | Partner Hierarchy
  |--------------------------------------------------------------------------
  */

  createdById String?

  createdBy user? @relation("PartnerHierarchy",fields: [createdById], references: [id])

  createdPartners user[] @relation("PartnerHierarchy")

  approvedById String?

  approvedBy user? @relation("PartnerApproval", fields: [approvedById],references: [id])

  approvedPartners user[] @relation("PartnerApproval")

  /*
  |--------------------------------------------------------------------------
  | Existing Relations
  |--------------------------------------------------------------------------
  */

  account account[]

  addresses address[]

  cart cart?

  orders order[]

  createdOrders order[] @relation("OrderCreatedBy")

  review review[]

  session session[]

  wishlist wishlist?

  /*
  |--------------------------------------------------------------------------
  | New Relations
  |--------------------------------------------------------------------------
  */

  partnerProfile PartnerProfile?

  userPermissions UserPermission[]

  assignedPermissions UserPermission[] @relation("AssignedPermissions")

  notifications UserNotification[]

  createdNotifications Notification[] @relation("NotificationCreator")
  activityLogs ActivityLog[]
  couponUsages CouponUsage[]
  wishlistCouponLogs WishlistCouponLog[]
  return_request return_request[]
  replacement_request replacement_request[]
  refund refund[]
  productQueries productQuery[]
  refundMethods user_refund_method[]
}

model PartnerProfile {
  id String @id @default(cuid())

  userId String @unique

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  profileImage String?

  companyName String?

  gstNumber String?

  panNumber String?

  aadhaarNumber String?

  addressLine1 String

  addressLine2 String?

  city String

  state String

  country String @default("India")

  pincode String

  idProofFront String?

  idProofBack String?

  selfieWithId String?

  remarks String?

  submittedAt DateTime?

  approvedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Permission {
  id          String @id @default(cuid())

  name        String @unique

  displayName String

  module      String

  category    PermissionCategory

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users UserPermission[]
}

model UserPermission {
  id String @id @default(cuid())

  userId String
  permissionId String

  assignedById String?

  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  assignedBy user? @relation("AssignedPermissions", fields: [assignedById], references: [id])

  @@unique([userId, permissionId])

  @@index([userId])

  @@index([permissionId])
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  type NotificationType

  entityType String?

  entityId String?

  createdAt DateTime @default(now())

  createdById String?

  createdBy user? @relation("NotificationCreator", fields: [createdById], references: [id])

  users UserNotification[]
}

model UserNotification {
  id String @id @default(cuid())

  notificationId String

  userId String

  isRead Boolean @default(false)

  readAt DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
}

model verificationtoken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token], map: "VerificationToken_identifier_token_key")
}

model ActivityLog {
  id String @id @default(cuid())

  userId String?

  user user? @relation(fields: [userId], references: [id], onDelete: SetNull)

  action ActivityAction

  module String

  entityId String?

  entityName String?

  description String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())

  email     String

  success   Boolean

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  @@index([email, createdAt])

  @@index([createdAt])
}

model return_request {
  id                String           @id @default(cuid())
  orderId           String
  userId            String
  reason            String           @db.Text
  reasonOption      String?
  customText        String?          @db.Text
  description       String?          @db.Text
  images            Json?
  status            ReturnStatus     @default(PENDING)
  timeline          Json?
  adminRemarks      Json?
  notes             String?          @db.Text
  pickupScheduledAt DateTime?
  pickupAddress     String?
  refundAmount      Decimal?         @db.Decimal(10, 2)
  refundMethod      String?
  bankDetails       Json?
  refundInitiatedBy String?
  refundProcessedAt DateTime?
  trackingNumber    String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  order             order            @relation(fields: [orderId], references: [id])
  user              user             @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model replacement_request {
  id                String             @id @default(cuid())
  orderId           String
  userId            String
  reason            String             @db.Text
  reasonOption      String?
  customText        String?            @db.Text
  description       String?            @db.Text
  images            Json?
  status            ReplacementStatus  @default(PENDING)
  timeline          Json?
  adminRemarks      Json?
  notes             String?            @db.Text
  pickupScheduledAt DateTime?
  pickupAddress     String?
  bankDetails       Json?
  trackingNumber    String?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  order             order              @relation(fields: [orderId], references: [id])
  user              user               @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model refund {
  id            String    @id @default(cuid())
  requestId     String
  requestType   String
  orderId       String
  userId        String
  amount        Decimal   @db.Decimal(10, 2)
  method        String
  accountHolder String?
